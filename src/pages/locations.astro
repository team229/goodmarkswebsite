---
import BaseLayout from '../layouts/BaseLayout.astro';
import LocationsList from '../components/LocationsList';
import { locationPages } from '../data/locations';

const title = 'Areas We Serve in Gurgaon & Manesar | Good Marks Classes';
const description = 'JEE, NEET and CBSE tuition for Gurgaon Sectors 78–99 and Manesar families. Sector 85 teaching centre, plus online, hybrid and home tuition options.';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.goodmarksclasses.com/' },
    { '@type': 'ListItem', position: 2, name: 'Areas We Serve', item: 'https://www.goodmarksclasses.com/locations' }
  ]
};

const listSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Good Marks Classes Service Areas',
  itemListElement: locationPages.map((page, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: page.title,
    url: `https://www.goodmarksclasses.com/locations/${page.slug}`
  }))
};
---
<BaseLayout title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(listSchema)} />
  <LocationsList client:load />
</BaseLayout>
