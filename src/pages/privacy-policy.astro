---
import BaseLayout from '../layouts/BaseLayout.astro';
import LegalDocument from '../components/LegalDocument';
import { privacyPolicyIntro, privacyPolicyMeta, privacyPolicySections } from '../data/privacyPolicy';
---

<BaseLayout
  title={`${privacyPolicyMeta.title} | Good Marks Classes`}
  description="How Good Marks Classes collects, uses and protects your personal information on our website and enrolments."
>
  <LegalDocument
    meta={privacyPolicyMeta}
    intro={privacyPolicyIntro}
    sections={privacyPolicySections}
    contactAfter="contact-us"
  />
</BaseLayout>
