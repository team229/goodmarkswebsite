---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogPost from '../../components/BlogPost';
import { generateBlogSchema } from '../../lib/blogSchema';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({ params: { slug: post.id } }));
}

const { slug } = Astro.params;
const posts = await getCollection('blog');
const entry = posts.find(p => p.id === slug);
const { data, body } = entry!;
const metaTitle = data.metaTitle;
const metaDescription = data.metaDescription;
// Server-rendered BlogPosting schema (client-only injection is invisible to crawlers).
const blogPostingSchema = generateBlogSchema({
  slug: entry!.id,
  title: data.title,
  excerpt: data.excerpt,
  date: data.date,
  updated: data.updated,
  image: data.image,
  metaTitle: data.metaTitle,
  metaDescription: data.metaDescription,
  category: data.category,
});
---
<BaseLayout title={metaTitle} description={metaDescription} jsonLd={[blogPostingSchema]}>
  <BlogPost client:load post={{
    slug: entry!.id,
    title: data.title,
    excerpt: data.excerpt,
    content: body,
    date: data.date,
    image: data.image,
    metaTitle: data.metaTitle,
    metaDescription: data.metaDescription,
    category: data.category,
  }} />
</BaseLayout>
