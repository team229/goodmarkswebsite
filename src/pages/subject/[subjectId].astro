};

const subjectMeta = meta[subjectId];
const subjectSchema = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: subjectMeta?.title.split('|')[0].trim() || 'Coaching Classes',
  description: subjectMeta?.description || '',
