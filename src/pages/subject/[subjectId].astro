    '@type': 'EducationalOrganization',
    name: 'Good Marks Classes',
    url: 'https://www.goodmarksclasses.com/'
  },
  url: `https://www.goodmarksclasses.com/subject/${subjectId}`
};

const subjectBreadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.goodmarksclasses.com/' },
    { '@type': 'ListItem', position: 2, name: 'Courses', item: 'https://www.goodmarksclasses.com/courses' },
    { '@type': 'ListItem', position: 3, name: subjectMeta?.title.split('|')[0].trim() || 'Coaching Classes', item: `https://www.goodmarksclasses.com/subject/${subjectId}` }
