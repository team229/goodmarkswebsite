---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SubjectDetail from '../../components/SubjectDetail';

export async function getStaticPaths() {
  const subjects = ['physics', 'chemistry', 'mathematics', 'biology'];
  return subjects.map(subjectId => ({ params: { subjectId } }));
}

const { subjectId } = Astro.params;
const meta: Record<string, { title: string; description: string }> = {
  biology: { title: 'Biology Coaching Classes for NEET & Foundation | Good Marks Classes', description: 'Explore Biology Coaching Classes at Good Marks Classes for NEET Class 12th Passout and Foundation batches for Class 9 & 10. Offline and online options available.' },
  chemistry: { title: 'Chemistry Coaching Classes for IIT-JEE, NEET & Foundation | Good Marks Classes', description: 'Explore Chemistry Coaching Classes at Good Marks Classes for IIT-JEE, NEET, and Foundation batches from Class 9 to 12th Passout. Offline and online options available.' },
  mathematics: { title: 'Mathematics Coaching Classes for IIT-JEE & Pre-Foundation | Good Marks Classes', description: 'Explore Mathematics Coaching Classes at Good Marks Classes for IIT-JEE batches from Class 11 to 12th Passout, plus Pre-Foundation programmes for Class 7 & 8. Offline and online options available.' },
  physics: { title: 'Physics Coaching Classes for IIT-JEE, NEET & Foundation | Good Marks Classes', description: 'Explore Physics Coaching Classes at Good Marks Classes for IIT-JEE, NEET, and Foundation batches from Class 9 to 12th Passout. Offline and online options available.' }
};

const subjectMeta = meta[subjectId];
const subjectSchema = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: subjectMeta?.title.split('|')[0].trim() || 'Coaching Classes',
  description: subjectMeta?.description || '',
  provider: {
    '@type': 'EducationalOrganization',
    name: 'Good Marks Classes',
    url: 'https://www.goodmarksclasses.com/'
  },
  url: `https://www.goodmarksclasses.com/subject/${subjectId}`
};

const subjectBreadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.goodmarksclasses.com/' },
    { '@type': 'ListItem', position: 2, name: 'Courses', item: 'https://www.goodmarksclasses.com/courses' },
    { '@type': 'ListItem', position: 3, name: subjectMeta?.title.split('|')[0].trim() || 'Coaching Classes', item: `https://www.goodmarksclasses.com/subject/${subjectId}` }
  ]
};
---
<BaseLayout title={subjectMeta?.title || 'Subject | Good Marks Classes'} description={subjectMeta?.description || ''}>
  <script type="application/ld+json" set:html={JSON.stringify(subjectSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(subjectBreadcrumbSchema)} />
  <SubjectDetail subjectId={subjectId} client:load />
</BaseLayout>
