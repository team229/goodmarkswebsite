};

const streamMeta = meta[stream];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.goodmarksclasses.com/' },
    { '@type': 'ListItem', position: 2, name: 'Courses', item: 'https://www.goodmarksclasses.com/courses' },
    { '@type': 'ListItem', position: 3, name: streamName[stream] || 'Courses', item: `https://www.goodmarksclasses.com/courses/${stream}` }
  ]
};

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: streamMeta?.title.split('|')[0].trim() || streamName[stream],
  description: streamMeta?.description || '',
