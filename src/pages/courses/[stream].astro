}

const { stream } = Astro.params;
const meta: Record<string, { title: string; description: string }> = {
  iit: { title: 'Best IIT JEE Coaching in Gurgaon | Repeaters Batch Available | GoodMarks Classes', description: 'Join the best IIT JEE coaching institute in Gurgaon. GoodMarks Classes offers regular batches and a dedicated JEE repeater course with focused revision, test series, and personalized guidance to boost your rank.' },
