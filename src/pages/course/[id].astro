---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getFaqs } from '../../lib/courseFaqs';
import CourseDetail from '../../components/CourseDetail';

export async function getStaticPaths() {
  const mod = await import('../../data/courses');
  const coursesData = mod.coursesData;
  const ids: string[] = [];
  for (const category of Object.values(coursesData)) {
    for (const course of category as any[]) {
      ids.push(course.id);
    }
  }
  return ids.map(id => ({ params: { id } }));
}

const { id } = Astro.params;

const mod = await import('../../data/courses');
let course: any = null;
for (const category of Object.values(mod.coursesData)) {
  const found = (category as any[]).find((c) => c.id === id);
  if (found) { course = found; break; }
}

const seoOverrides: Record<string, { title: string; description: string }> = {
  '1-year-regular-12': {
    title: '1 Year JEE Coaching in Gurgaon | GoodMarks Classes',
    description: 'Focused 1 year JEE coaching in Gurgaon with structured classes, expert faculty and proven results to crack IIT JEE in one year.'
  },
  '1-year-regular-12-neet': {
    title: '1 Year NEET Coaching in Gurgaon | GoodMarks Classes',
    description: 'Intensive 1 year NEET coaching in Gurgaon covering Biology, Chemistry and Physics with mentorship and regular mock tests.'
  },
  '2-year-integrated-regular': {
    title: '2 Year JEE Coaching Program in Gurgaon | GoodMarks',
    description: 'Build a strong foundation with our 2 year JEE program in Gurgaon — study plans, experienced faculty and consistent practice.'
  },
  '2-year-integrated-regular-neet': {
    title: '2 Year NEET Coaching in Gurgaon | GoodMarks Classes',
    description: '2 year NEET coaching in Gurgaon with NCERT-based teaching, in-depth subject coverage and continuous assessment.'
  },
  '1-year-extended-classroom-jee': {
    title: '1-Year JEE Classroom Program | GoodMarks Classes',
    description: 'Extended 1-year JEE classroom program in Gurgaon — concept depth, daily practice and test series for IIT-JEE.'
  },
  '1-year-extended-classroom-neet': {
    title: '1-Year NEET Classroom Program | GoodMarks Classes',
    description: 'Extended 1-year NEET classroom program in Gurgaon — NCERT depth, daily practice and mock tests for NEET-UG.'
  }
};

function seoTitle(c: any): string {
  if (!c) return 'Course Details | GoodMarks Classes';
  if (seoOverrides[c.id]) return seoOverrides[c.id].title;
  const headings: Record<string, string> = {
    'cbse-tuition-class-8': 'Class 8 CBSE Tuition in Gurgaon | GoodMarks Classes',
    'cbse-tuition-class-9': 'Class 9 CBSE Tuition in Gurgaon | GoodMarks Classes',
    'cbse-tuition-class-10': 'Class 10 CBSE Tuition in Gurgaon | GoodMarks Classes',
    'cbse-tuition-class-11': 'Class 11 CBSE Tuition (PCMB) Gurgaon | GoodMarks',
    'cbse-tuition-class-12': 'Class 12 CBSE Tuition (PCMB) Gurgaon | GoodMarks'
  };
  if (headings[c.id]) return headings[c.id];
  const shortTitle = String(c.title || '').replace(/\s*\(.*?\)\s*/g, '').trim();
  return `${shortTitle} | GoodMarks Classes`;
}

function trimDesc(text: string, cap = 158): string {
  const clean = String(text || '').replace(/\s+/g, ' ').trim();
  if (clean.length <= 160) return clean;
  const head = clean.slice(0, cap);
  const cut = head.lastIndexOf('. ');
  if (cut > 100) return head.slice(0, cut + 1);
  const sp = head.lastIndexOf(' ');
  return head.slice(0, sp > 0 ? sp : cap).replace(/[ ,—–:;\-]+$/, '') + '.';
}

function seoDesc(c: any): string {
  if (!c) return 'Course details, schedule and enrolment info — GoodMarks Classes, Gurgaon.';
  if (seoOverrides[c.id]) return seoOverrides[c.id].description;
  return trimDesc(`${c.title} at GoodMarks Classes in Gurgaon — ${c.details?.schedule || ''} Schedule, subjects, features and how to enrol.`);
}

const pageTitle = seoTitle(course);
const pageDesc = seoDesc(course);

const courseSchema = course ? {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: pageTitle.split('|')[0].trim(),
  description: (course.details?.description || '').split('\n')[0].slice(0, 300),
  provider: {
    '@type': 'EducationalOrganization',
    name: 'Good Marks Classes',
    url: 'https://www.goodmarksclasses.com/'
  },
  url: `https://www.goodmarksclasses.com/course/${course.id}`,
  offers: {
    '@type': 'Offer',
    category: course.tag || 'Coaching',
    availability: 'https://schema.org/InStock'
  }
} : null;

const courseBreadcrumbSchema = course ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.goodmarksclasses.com/' },
    { '@type': 'ListItem', position: 2, name: 'Courses', item: 'https://www.goodmarksclasses.com/courses' },
    { '@type': 'ListItem', position: 3, name: course.title, item: `https://www.goodmarksclasses.com/course/${course.id}` }
  ]
} : null;

// FAQPage schema is generated from the same getFaqs() source that renders the
// visible FAQ accordion in CourseDetail — schema and page can never drift apart.
const courseFaqSchema = course ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: getFaqs(course).map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: { '@type': 'Answer', text: faq.a },
  })),
} : null;

const courseWebPageSchema = course && course.id === '2-year-integrated-regular' ? {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': 'https://www.goodmarksclasses.com/course/2-year-integrated-regular/',
  url: 'https://www.goodmarksclasses.com/course/2-year-integrated-regular/',
  name: '2 Year JEE Coaching Program in Gurgaon | GoodMarks',
  description: 'Build a strong foundation with our 2 year JEE program in Gurgaon — study plans, experienced faculty and consistent practice.',
  inLanguage: 'en-IN',
  isPartOf: {
    '@type': 'WebSite',
    '@id': 'https://www.goodmarksclasses.com/#website',
    url: 'https://www.goodmarksclasses.com/',
    name: 'GoodMarks Classes'
  },
  about: {
    '@type': 'Course',
    name: '2 Year Integrated IIT JEE Program',
    description: 'A comprehensive 2 year integrated classroom program for IIT JEE preparation offered in Gurgaon by GoodMarks Classes, covering foundational to advanced concepts with experienced faculty and consistent practice.',
    provider: {
      '@type': 'EducationalOrganization',
      name: 'GoodMarks Classes',
      url: 'https://www.goodmarksclasses.com/',
      areaServed: 'Gurgaon'
    }
  },
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.goodmarksclasses.com/' },
      { '@type': 'ListItem', position: 2, name: 'Courses', item: 'https://www.goodmarksclasses.com/courses/' },
      { '@type': 'ListItem', position: 3, name: '2 Year IIT JEE Program Gurgaon', item: 'https://www.goodmarksclasses.com/course/2-year-integrated-regular/' }
    ]
  }
} : null;


---
<BaseLayout title={pageTitle} description={pageDesc}>
  {courseSchema && <script type="application/ld+json" set:html={JSON.stringify(courseSchema)} />}
  {courseBreadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(courseBreadcrumbSchema)} />}
  {courseFaqSchema && <script type="application/ld+json" set:html={JSON.stringify(courseFaqSchema)} />}
  {courseWebPageSchema && <script type="application/ld+json" set:html={JSON.stringify(courseWebPageSchema)} />}
  <CourseDetail id={id} client:load />
</BaseLayout>
