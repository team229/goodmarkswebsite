---
import BaseLayout from '../layouts/BaseLayout.astro';
import Home from '../components/Home';

const webSiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Good Marks Classes',
  url: 'https://www.goodmarksclasses.com',
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: 'https://www.goodmarksclasses.com/?s={search_term_string}'
    },
    'query-input': 'required name=search_term_string'
  }
};
---
<BaseLayout title="JEE & NEET Coaching in Gurgaon | GoodMarks Classes" description="JEE & NEET coaching in Gurgaon with expert faculty, small batches and personal attention for Class 9–12. Book a free demo class today.">
  <script type="application/ld+json" set:html={JSON.stringify(webSiteSchema)} />
  <Home client:load />
</BaseLayout>
